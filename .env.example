# Copie para .env e preencha.

PORT=3000

# Banco (os valores abaixo batem com o docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=kb
DB_PASSWORD=kb
DB_NAME=knowledge_base
# Use true em bancos na nuvem (Neon, Supabase etc.)
DB_SSL=false
# Só use false se o provedor tiver certificado que não valida
DB_SSL_REJECT_UNAUTHORIZED=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula. Vazio = nenhuma.
CORS_ORIGIN=http://localhost:5173

# Chave do webhook do n8n (header X-API-Key). Vazio = integração desativada.
# Gere com o mesmo comando do JWT_SECRET.
N8N_API_KEY=

# Usado apenas por `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
